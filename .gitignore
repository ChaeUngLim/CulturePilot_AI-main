# ─────────────────────────────────────────────────────────────
#  키 · 비밀값 — 절대 커밋하지 않는다
#
#  한 번 커밋되면 나중에 지워도 이력에 남는다. 그때는 키 재발급이
#  유일한 해결책이다.
#
#  `.env` 로 시작하는 파일은 예외 없이 전부 제외한다. `.env.example`
#  같은 템플릿도 마찬가지다 — 자리표시자로 시작했다가 나중에 누군가
#  실제 값을 채워 넣고 그대로 커밋하는 사고가 흔하다. 필요한 키 목록은
#  `culturemate/docs/SETUP.md` 가 문서로 관리한다.
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.p12
secrets.json

# Claude Code 로컬 설정 — 사용자마다 다른 권한 허용 목록이라 공유하지 않는다.
# launch.json 은 프리뷰 서버 정의라 공유한다.
.claude/settings.local.json

# ─────────────────────────────────────────────────────────────
#  파이썬
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
#  Node · Expo
# ─────────────────────────────────────────────────────────────
node_modules/
.expo/
.expo-shared/
dist/
web-build/
npm-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────
#  대용량 산출물 — 소스에서 다시 만들 수 있는 것
# ─────────────────────────────────────────────────────────────
# mobile/ 를 통째로 압축한 사본(153MB). 원본이 저장소에 있으므로 중복이다.
mobile.zip

# ─────────────────────────────────────────────────────────────
#  잘못된 볼륨 마운트가 만든 빈 디렉터리 — 이름에 ';' 가 들어가 있어
#  리눅스/맥에서 체크아웃이 깨진다.
# ─────────────────────────────────────────────────────────────
*;C/

# ─────────────────────────────────────────────────────────────
#  에디터 · OS
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
