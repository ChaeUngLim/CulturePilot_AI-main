	__end__([<p>__end__</p>]):::last
	__start__ --> ctx_geo;
	__start__ --> ctx_hours;
	__start__ --> ctx_preference;
	__start__ --> ctx_weather;
	assemble_constraints --> schedule;
	ctx_geo --> assemble_constraints;
	ctx_hours --> assemble_constraints;
	ctx_preference --> assemble_constraints;
	ctx_weather --> assemble_constraints;
	detect_gaps -.-> fill_gaps;
	detect_gaps -.-> nearby_search;
	nearby_search --> rerank_nearby;
	rerank_nearby --> fill_gaps;
