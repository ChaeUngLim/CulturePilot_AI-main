config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	ctx_geo(ctx_geo)
	ctx_hours(ctx_hours)
	ctx_weather(ctx_weather)
	ctx_preference(ctx_preference)
	assemble_constraints(assemble_constraints)
	schedule(schedule)
	detect_gaps(detect_gaps)
	nearby_search(nearby_search)
	rerank_nearby(rerank_nearby)
